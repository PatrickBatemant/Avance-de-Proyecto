const express = require('express');
const mongoose = require('mongoose');
const cors = require('cors');
require('dotenv').config();

const app = express();

// Middlewares
app.use(cors()); // Soluciona errores de CORS de tu PDF
app.use(express.json());

// Conexión a Base de Datos
mongoose.connect(process.env.MONGO_URI)
  .then(() => console.log('MongoDB Conectado'))
  .catch(err => console.log(err));

// Rutas
app.use('/api/auth', require('./routes/auth'));
app.use('/api/tasks', require('./routes/tasks'));

// Error 404 (Route Not Found)
app.use((req, res, next) => {
  res.status(404).json({ error: 'Ruta no encontrada' });
});

// Middleware global de errores 
app.use((err, req, res, next) => {
  if (res.headersSent) return next(err); // Por si acaso se presenta "Headers already sent", esto trata de evitarlo
  console.error(err.stack);
  res.status(err.status || 500).json({ error: err.message || 'Error del servidor' });
});

app.listen(process.env.PORT, () => console.log(`Servidor en puerto ${process.env.PORT}`));